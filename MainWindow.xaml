<Window x:Class="RBM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RBM"
        mc:Ignorable="d"
        Title="RBM" Height="768" Width="1024" Loaded="Window_Loaded" MinWidth="800" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="入力" FontSize="14"/>
            <TextBlock TextWrapping="Wrap"><Run Language="ja-jp" Text="タイトル"/></TextBlock>
            <TextBox x:Name="book_title" TextWrapping="Wrap"/>
            <TextBlock TextWrapping="Wrap" Text="著者"/>
            <TextBox x:Name="book_author" TextWrapping="Wrap"/>
            <Button x:Name="save_button" Content="保存" HorizontalAlignment="Right" Margin="0,0,10,0" Click="save_button_Click"/>
        </StackPanel>
        <DockPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" DockPanel.Dock="Top" Text="出力" FontSize="14"/>
            <DataGrid x:Name="booksTable" d:ItemsSource="{d:SampleData ItemCount=10}" AreRowDetailsFrozen="True"/>
        </DockPanel>

    </Grid>
</Window>
